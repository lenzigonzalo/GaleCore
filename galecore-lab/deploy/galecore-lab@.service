# Lab de GaleCore por trader (WS-0088). Instancia = usuario Linux: galecore-lab@elenzi, @glenzi.
# Config por instancia en /etc/galecore-lab/<i>.env (GALECORE_LAB_PORT).
[Unit]
Description=GaleCore Lab for %i
After=network.target galecore-datafeed.service

[Service]
Type=simple
User=%i
WorkingDirectory=/srv/galecore/lab
EnvironmentFile=/home/%i/.galecore-ai.env
EnvironmentFile=/etc/galecore-lab/%i.env
Environment=GALECORE_LAB_LOCAL=/home/%i/.galecore/lab-state
Environment=GALECORE_LAB_ORIGINS=https://galecore.vercel.app
Environment=GALECORE_LAB_SSH=-p 5061 %i@vps-6285555-x.dattaweb.com
Environment=MAX_SESSIONS=2
Environment=NODE_ENV=production
Environment=PATH=/home/%i/.local/bin:/srv/galecore/ai/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /srv/galecore/lab/lab-server.js
Restart=on-failure
RestartSec=5s
MemoryHigh=400M
MemoryMax=600M
CPUQuota=150%
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/%i/.galecore /home/%i/.claude /home/%i/.codex
PrivateTmp=true

[Install]
WantedBy=multi-user.target
